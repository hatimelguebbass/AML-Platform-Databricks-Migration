/// Transfers that made each alert fire (gold.aml_alert_transfer).
table 'Alert evidence'
	lineageTag: eb1475e6-d2a3-590e-932a-f5d004d3a606

	/// Transfers behind the alerts in the filter context.
	measure 'Evidence transfers' = COUNTROWS ( 'Alert evidence' )
		formatString: #,0
		lineageTag: a07c8711-b5a2-57c6-886e-b930099a51ff

	measure 'Evidence amount (USD)' = SUM ( 'Alert evidence'[Amount] )
		formatString: #,0
		lineageTag: eec8bdd6-3b5e-546f-9ef2-e6a205d40473

	column 'Alert ID'
		dataType: string
		isHidden
		lineageTag: 5a0de428-1f0b-5e5f-aff8-5a00abc40d55
		summarizeBy: none
		sourceColumn: alert_id

	column 'Transfer ID'
		dataType: string
		lineageTag: 1798267b-9d4d-5ca8-b88b-0cf86befaa1c
		summarizeBy: none
		sourceColumn: transfer_id

	/// DEBIT when the alerted account paid, CREDIT when it was paid.
	column 'Evidence role'
		dataType: string
		lineageTag: 4d9611b6-3fbe-50bc-999b-f31095acc78e
		summarizeBy: none
		sourceColumn: evidence_role

	column 'Booked at'
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		lineageTag: 7ad6d0a0-da75-5497-94f4-117e168a3e87
		summarizeBy: none
		sourceColumn: booked_at

	column 'Counterparty account ID'
		dataType: int64
		formatString: 0
		lineageTag: 87076427-207e-5897-8aff-6d9e7f93b149
		summarizeBy: none
		sourceColumn: counterparty_account_id

	/// Amount paid, in USD.
	column Amount
		dataType: decimal
		formatString: #,0.00
		lineageTag: 00d422db-b42d-5c0c-bd60-a0c460fe8dbf
		summarizeBy: none
		sourceColumn: amount

	partition 'Alert evidence' = m
		mode: import
		source =
				let
				    Source = Lakehouse{[Name = "gold", Kind = "Schema"]}[Data]{[Name = "aml_alert_transfer", Kind = "Table"]}[Data],
				    Columns = Table.SelectColumns(Source, {"alert_id", "transfer_id", "evidence_role", "booked_at", "counterparty_account_id", "amount"}),
				    Typed = Table.TransformColumnTypes(Columns, {{"alert_id", type text}, {"transfer_id", type text}, {"evidence_role", type text}, {"booked_at", type datetime}, {"counterparty_account_id", Int64.Type}, {"amount", Currency.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table
